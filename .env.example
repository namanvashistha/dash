# Copy to .env on the server (it's gitignored). docker-compose auto-reads it.

# REQUIRED. Cloudflare Tunnel connector token — the only way traffic reaches
# this box now that Caddy publishes no host ports. Compose refuses to start
# cloudflared without it.
#   dash.cloudflare.com -> Zero Trust -> Networks -> Tunnels -> Create a tunnel
#   -> Cloudflared -> copy the token out of the install command it shows.
# Then under that tunnel's Public Hostnames add:
#   *.namanvashistha.com  ->  HTTP  ->  caddy:80
# (a wildcard, so new services need no dashboard edit — just the caddy label)
CF_TUNNEL_TOKEN=

# Optional: GitHub token (classic, public_repo scope) — lifts the 60/hr anon
# limit for the Glance repository/releases widgets. Blank = anonymous.
GLANCE_GITHUB_TOKEN=

# Optional: Home Assistant long-lived access token — enables the "Home
# Assistant" bridge widget on the Infra page. Create one in HA:
# profile (bottom-left) → Security → Long-lived access tokens → Create.
# Blank = the HA widget shows an auth error (everything else still works).
HA_TOKEN=

# Docmost (self-hosted wiki at docs.namanvashistha.com). BOTH are required for
# the docmost/docmost-db containers to boot — leaving them blank breaks startup.
# Generate the secret with: openssl rand -hex 32
DOCMOST_APP_SECRET=
# Postgres password for the docmost DB. Pick any strong string (used by both
# docmost and docmost-db). Changing it after first boot means recreating the DB.
DOCMOST_DB_PASSWORD=

# Beszel (monitoring at status.namanvashistha.com). Only the AGENT needs these;
# the hub boots fine without them. Get them after the hub's first boot:
#   Settings -> Tokens & Fingerprints -> universal token  (that's BESZEL_TOKEN)
#   "Add System" dialog -> the public key it shows        (that's BESZEL_KEY)
# Then `docker compose up -d beszel-agent` and add the system in the UI with
# Host/IP = /beszel_socket/beszel.sock
BESZEL_TOKEN=
BESZEL_KEY=

# AutoKuma -> Uptime Kuma (uptime.namanvashistha.com). Uptime Kuma has no API
# tokens, so AutoKuma signs in as a real user. Only AutoKuma needs these; Kuma
# itself boots fine without them.
# Order matters: bring the stack up, open uptime.namanvashistha.com, create the
# admin account, put it here, then `docker compose up -d autokuma`. Until then
# AutoKuma restart-loops on failed login, which is harmless.
AUTOKUMA_USERNAME=
AUTOKUMA_PASSWORD=

# Komodo (deploy controller at komodo.namanvashistha.com). All four are
# REQUIRED before komodo-core will work — but compose falls back to empty
# strings rather than refusing to start, deliberately: a missing value here
# must not take caddy and cloudflared down with it on a fresh box.
#
# Upstream's install puts these in a separate komodo/compose.env passed with
# --env-file. They live here instead so this box keeps ONE secrets file.
#
# Generate the two secrets:
#   openssl rand -hex 32
#
# The DB password is read by Mongo only on FIRST boot, when it initialises the
# root user. Changing it later does not change the user — it just locks Core
# out until you either change it back or delete the komodo-mongo-data volume.
KOMODO_DB_PASSWORD=
# Only creates this account on first boot, when the user table is empty.
# Change the password afterwards in the UI, not here.
KOMODO_ADMIN_PASSWORD=
# Signs session tokens. Rotating it logs everyone out; that is its only effect.
KOMODO_JWT_SECRET=
# Authenticates incoming GitHub webhooks. Must match the secret you paste into
# the repo's webhook settings, or pushes are silently rejected.
KOMODO_WEBHOOK_SECRET=

# Optional Komodo overrides — defaults in docker-compose.yml are fine:
#   KOMODO_DB_USERNAME    (default: komodo)
#   KOMODO_ADMIN_USERNAME (default: admin)
#   KOMODO_SERVER_NAME    (default: Local — must match the server Core creates
#                          on first boot, or Periphery cannot attach)
#   KOMODO_IMAGE_TAG      (default: 2 — the major version line)
